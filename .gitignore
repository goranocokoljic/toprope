# Dependencies
node_modules/

# Build output
dist/

# IDE
.idea/

# Environment / secrets
.env
.env.*

# Review artifacts
reviews/
.review-diff.patch

# Test coverage reports
coverage/

# Per-task dev-cycle reports (human-readable; remove this line to commit them as project history)
reports/

# Logs
*.log

# Local dev-cycle wrapper (personal workflow helper, not part of the package)
run-issues.ps1
dev-cycle-logs/
# Ignore local analytics, but keep the review knowledge base tracked (it's the
# accumulating source of truth). Note: glob the CONTENTS, not the dir, so the
# negations below can re-include specific files.
dev-cycle-analytics/*
!dev-cycle-analytics/review-lessons.jsonl
!dev-cycle-analytics/REVIEW_KB.md

backup/

# Local SQLite dev database (generated at runtime, not project history)
data/*.db
data/*.db-shm
data/*.db-wal
