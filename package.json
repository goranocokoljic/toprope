{
    "name": "govproxy",
    "version": "0.1.0",
    "description": "AI adoption intelligence platform for engineering teams",
    "main": "dist/server.js",
    "bin": {
        "govproxy": "./bin/index.js"
    },
    "scripts": {
        "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "tsx src/server.ts",
        "dev:web": "vite --config src/dashboard/frontend/vite.config.ts",
        "build": "npm run build:web && tsc && node -e \"require('fs').cpSync('src/storage/migrations','dist/storage/migrations',{recursive:true})\"",
        "build:web": "tsc --noEmit -p src/dashboard/frontend/tsconfig.json && vite build --config src/dashboard/frontend/vite.config.ts",
        "test": "vitest run",
        "lint": "eslint src tests --ext .ts",
        "lint:web": "eslint src/dashboard/frontend --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "typecheck:web": "tsc --noEmit -p src/dashboard/frontend/tsconfig.json"
    },
    "dependencies": {
        "@fastify/static": "^8.3.0",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/space-grotesk": "^5.2.10",
        "@tanstack/react-query": "^5.100.14",
        "ajv": "^8.17.1",
        "better-sqlite3": "^11.5.0",
        "commander": "^12.1.0",
        "fastify": "^5.2.1",
        "js-yaml": "^4.1.0",
        "node-cron": "^3.0.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.30.3",
        "recharts": "^2.15.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/better-sqlite3": "^7.6.11",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.10.0",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^18.3.29",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.5.0",
        "concurrently": "^9.2.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.26",
        "jsdom": "^25.0.1",
        "postcss": "^8.5.15",
        "prettier": "^3.4.2",
        "tailwindcss": "3.4",
        "tsx": "^4.19.1",
        "typescript": "^5.7.2",
        "vite": "^5.4.21",
        "vitest": "^2.1.8"
    }
}
